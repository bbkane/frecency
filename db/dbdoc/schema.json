        {
          "name": "create_datetime_rfc3339",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "update_datetime_rfc3339",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "access_count",
          "type": "INT",
          "nullable": true
        },
        {
          "name": "last_access_datetime_rfc3339",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "frecency_score",
          "type": "REAL",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW item_frecency AS\nSELECT\n  i.id,\n  i.item,\n  i.base_score,\n  CAST(strftime('%Y-%m-%dT%H:%M:%SZ', i.create_time, 'unixepoch') AS TEXT) AS create_datetime_rfc3339,\n  CAST(strftime('%Y-%m-%dT%H:%M:%SZ', i.update_time, 'unixepoch') AS TEXT) AS update_datetime_rfc3339,\n  CAST(COUNT(l.id) AS INTEGER) AS access_count,\n  CAST(CASE\n    WHEN MAX(l.access_time) IS NULL THEN NULL\n    ELSE strftime('%Y-%m-%dT%H:%M:%SZ', MAX(l.access_time), 'unixepoch')\n  END AS TEXT) AS last_access_datetime_rfc3339,\n  CAST(i.base_score\n  + COALESCE(\n    SUM(1.0 / (1.0 + MAX(unixepoch() - l.access_time, 0) / 604800.0)),\n    0\n  ) AS REAL) AS frecency_score\nFROM item AS i\nLEFT JOIN access_log AS l ON l.item_id = i.id\nGROUP BY\n  i.id,\n  i.item,\n  i.base_score,\n  i.create_time,\n  i.update_time",
      "referenced_tables": [
        "item",
        "access_log"
      ]
    }
