    {
      "name": "item_frecency",
      "type": "view",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "nullable": true
        },
        {
          "name": "item",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "base_score",
          "type": "INTEGER",
          "nullable": true
